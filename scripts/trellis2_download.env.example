# Copy this file to a local path such as scripts/trellis2_download.env and edit it.
# Do not commit files containing real Hugging Face tokens.

# Directory where dataset roots will be created.
TRELLIS2_DATA_ROOT="${TRELLIS2_REPO_ROOT}/datasets"

# Dataset profile or comma-separated dataset list.
# Recommended first pass: train
# Available profiles: train, test, all
# Available datasets: ObjaverseXL,ABO,HSSD,TexVerse,SketchfabPicked,Toys4k
TRELLIS2_DATASETS="train"

# ObjaverseXL sources.
TRELLIS2_OBJAVERSEXL_SOURCES="sketchfab,github"

# TexVerse texture resolution. Can be comma-separated.
TRELLIS2_TEXVERSE_RESOLUTION="2k"

# Optional custom TexVerse metadata/manifest.
TRELLIS2_TEXVERSE_METADATA_FILE=""
TRELLIS2_TEXVERSE_MANIFEST=""
TRELLIS2_TEXVERSE_REPO_ID=""

# Required only when downloading SketchfabPicked unless raw files already exist.
TRELLIS2_SKETCHFAB_PICKED_MANIFEST=""

# Retry behavior.
TRELLIS2_RETRIES="999"
TRELLIS2_SLEEP_SECONDS="10"

# Optional Hugging Face token. HSSD requires access to hssd/hssd-models.
# Prefer setting this in your scheduler secret store or shell instead of writing it here.
HF_TOKEN=""

# If 1, login to Hugging Face with HF_TOKEN before downloading.
TRELLIS2_HF_LOGIN="1"

# If 1, print the resolved command and exit without downloading.
TRELLIS2_DRY_RUN="0"
